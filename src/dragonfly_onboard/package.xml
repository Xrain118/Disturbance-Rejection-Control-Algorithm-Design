<?xml version="1.0"?>
<package format="3">
  <name>dragonfly_onboard</name>
  <version>0.1.0</version>
  <description>Hardware-only bringup entry point for Dragonfly onboard computers.</description>
  <maintainer email="dragonfly@example.com">Dragonfly</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>dragonfly_arm</exec_depend>
  <exec_depend>dragonfly_control</exec_depend>
  <exec_depend>dragonfly_fcu_bridge</exec_depend>
  <exec_depend>dragonfly_serial</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
